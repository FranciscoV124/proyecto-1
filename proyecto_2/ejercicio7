import cv2
import matplotlib.pyplot as plt
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent

# Cargar imagen en escala de grises
imagen = cv2.imread(str(BASE_DIR / "imagenes" / "darlecolor.png"), cv2.IMREAD_GRAYSCALE)

if imagen is None:
    print("Error al cargar la imagen")
    exit()

# Aplicar mapa de color
imagen_color = cv2.applyColorMap(imagen, cv2.COLORMAP_OCEAN)

# Guardar resultado
cv2.imwrite(str(BASE_DIR / "imagenes" / "dalecolor.png"), imagen_color)

# Mostrar original y resultado
plt.figure(figsize=(10, 4))

plt.subplot(1, 2, 1)
plt.imshow(imagen, cmap="gray")
plt.title("Imagen original")
plt.axis("off")

plt.subplot(1, 2, 2)
plt.imshow(cv2.cvtColor(imagen_color, cv2.COLOR_BGR2RGB))
plt.title("Imagen con color")
plt.axis("off")

plt.tight_layout()
plt.show()