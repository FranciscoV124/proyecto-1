from PIL import Image
import numpy as np
import matplotlib.pyplot as plt

# Cargar imagen
imagen = Image.open("proyecto_2/imagenes/rgb.png").convert("RGB")

# Separar canales
R, G, B = imagen.split()

# Convertir a arreglos numpy
r = np.array(R)
g = np.array(G)
b = np.array(B)

# Crear imágenes visuales de cada plano en color
plano_rojo = np.zeros((r.shape[0], r.shape[1], 3), dtype=np.uint8)
plano_verde = np.zeros((g.shape[0], g.shape[1], 3), dtype=np.uint8)
plano_azul = np.zeros((b.shape[0], b.shape[1], 3), dtype=np.uint8)

plano_rojo[:, :, 0] = r
plano_verde[:, :, 1] = g
plano_azul[:, :, 2] = b

# Calcular área ocupada (pixeles distintos de 0)
area_r = np.count_nonzero(r)
area_g = np.count_nonzero(g)
area_b = np.count_nonzero(b)

print("Área ocupada por el plano R:", area_r, "pixeles")
print("Área ocupada por el plano G:", area_g, "pixeles")
print("Área ocupada por el plano B:", area_b, "pixeles")

# Mostrar imágenes
plt.figure(figsize=(12, 4))

plt.subplot(1, 4, 1)
plt.imshow(imagen)
plt.title("Imagen original")
plt.axis("off")

plt.subplot(1, 4, 2)
plt.imshow(plano_rojo)
plt.title("Plano Red")
plt.axis("off")

plt.subplot(1, 4, 3)
plt.imshow(plano_verde)
plt.title("Plano Green")
plt.axis("off")

plt.subplot(1, 4, 4)
plt.imshow(plano_azul)
plt.title("Plano Blue")
plt.axis("off")

plt.tight_layout()
plt.show()